- user_record = @user || User.find(params[:id])
- roles = if user_record.superadmin_role? then ["Superadmin", "Editor"] elsif user_record.supervisor_role? then ["Editor"] elsif user_record.user_role? then ["Viewer"] else [] end
- summary_rows = [["Updated", l(user_record.updated_at, format: :short), "muted"]]
- self_role_guard_message = admin_user_role_guard_message(user_record, current_user)
- last_superadmin = admin_last_superadmin?(user_record)
- pending_email = user_record.pending_email_change? ? user_record.pending_email : nil
- role_switch_data = { action: "change->user-access-guard#enforce" }
- superadmin_id = dom_id(user_record, :superadmin_role)
- supervisor_id = dom_id(user_record, :supervisor_role)
- user_role_id = dom_id(user_record, :user_role)

= form_for [:admin, user_record], html: { class: "admin-editor admin-editor--user" } do |f|
  - if user_record.errors.any?
    .admin-form-errors
      - user_record.errors.full_messages.each do |msg|
        .alert.alert-danger.mb-3 = msg

  section.admin-workspace
    .admin-workspace__header
      .admin-workspace__header-copy
        p.admin-kicker Team access
        h1.admin-workspace__title Edit user
        p.admin-workspace__lead Access controls only. Keep the role set minimal.
      .admin-workspace__actions
        = link_to "Back to team", admin_users_path, class: "btn btn-outline-secondary"
        = f.submit "Save changes", class: "btn btn-primary"

    .admin-panel-grid.admin-panel-grid--split.admin-user-editor
      section.card.section-card.admin-panel.admin-user-editor__main data-controller="user-access-guard" data-user-access-guard-self-value=(current_user == user_record) data-user-access-guard-last-superadmin-value=last_superadmin
        .admin-panel__header
          div
            p.admin-kicker Access
            h2.admin-panel__title Roles
            p.admin-panel__copy Three compact switches without duplicate labels or long explanations.

        - if self_role_guard_message.present?
          .alert.alert-warning.admin-user-editor__warning data-user-access-guard-target="warning"
            = self_role_guard_message

        .admin-role-list
          .admin-role-row
            .admin-role-row__copy
              .admin-role-row__heading
                strong.admin-role-row__title Superadmin
                span.admin-role-row__state data-user-access-guard-target="superadminState" hidden=true Locked
              span.admin-role-row__meta Full site and team control
            .admin-role-row__switch
              .form-check.form-switch
                = f.check_box :superadmin_role, class: "form-check-input input-card__switch", id: superadmin_id, data: role_switch_data.merge(user_access_guard_target: "superadmin")
                = f.label :superadmin_role, "Toggle superadmin", class: "visually-hidden", for: superadmin_id

          .admin-role-row data-user-access-guard-target="supervisorRow"
            .admin-role-row__copy
              .admin-role-row__heading
                strong.admin-role-row__title Editor
                span.admin-role-row__state data-user-access-guard-target="supervisorState" hidden=true Included
              span.admin-role-row__meta Homes, galleries and content
            .admin-role-row__switch
              .form-check.form-switch
                = f.check_box :supervisor_role, class: "form-check-input input-card__switch", id: supervisor_id, data: role_switch_data.merge(user_access_guard_target: "supervisor")
                = f.label :supervisor_role, "Toggle editor", class: "visually-hidden", for: supervisor_id

          .admin-role-row data-user-access-guard-target="viewerRow"
            .admin-role-row__copy
              .admin-role-row__heading
                strong.admin-role-row__title Viewer
                span.admin-role-row__state data-user-access-guard-target="viewerState" hidden=true Included
              span.admin-role-row__meta Dashboard-only access
            .admin-role-row__switch
              .form-check.form-switch
                = f.check_box :user_role, class: "form-check-input input-card__switch", id: user_role_id, data: role_switch_data.merge(user_access_guard_target: "viewer")
                = f.label :user_role, "Toggle viewer", class: "visually-hidden", for: user_role_id

      aside.card.section-card.admin-panel.admin-user-editor__aside
        .admin-panel__header
          div
            p.admin-kicker Account
            h2.admin-panel__title Snapshot
            p.admin-panel__copy Sign-in email and active access.

        .admin-user-editor__field
          span.admin-user-editor__label Email
          p.admin-user-editor__field-value = user_record.email
          - if pending_email.present?
            p.admin-user-editor__field-note = "Pending verification: #{pending_email}"
          - else
            p.admin-user-editor__field-note Login address for this account.

        .admin-badge-stack.admin-badge-stack--start.admin-user-editor__badges
          - if roles.any?
            - roles.each do |role|
              - tone = role == "Superadmin" ? "success" : role == "Editor" ? "accent" : "muted"
              span class="admin-pill admin-pill--#{tone}" = role
          - else
            span.admin-pill.admin-pill--muted No role

        .admin-summary-list.admin-summary-list--compact
          - summary_rows.each do |label, value, tone|
            .admin-summary-list__item
              span.admin-summary-list__label = label
              span class="admin-summary-list__value admin-summary-list__value--#{tone}" = value

        .admin-user-editor__aside-actions
          = button_tag "Change email", type: "button", class: "btn btn-outline-secondary", onclick: "Stimulus.getControllerForElementAndIdentifier(document.getElementById('change_email_modal'), 'email-change').open()"
          = button_tag "Change password", type: "button", class: "btn btn-outline-primary", onclick: "Stimulus.getControllerForElementAndIdentifier(document.getElementById('change_password_modal'), 'change-password').open()"

#change_email_modal[
  data-controller="email-change"
  data-send-url=send_email_change_code_admin_user_path(user_record)
  data-confirm-url=confirm_email_change_admin_user_path(user_record)
  data-current-email=user_record.email
  data-pending-email=(pending_email || "")
]
#change_password_modal[data-controller="change-password" data-url=change_password_admin_user_path(user_record)]
