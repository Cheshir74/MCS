section.admin-workspace
  .admin-workspace__hero.admin-workspace__hero--compact
    .admin-workspace__hero-main
      p.admin-kicker Dashboard
      h1.admin-workspace__title Control center
      p.admin-workspace__lead Homepage publishing and site settings.

  section.card.section-card.admin-panel.admin-homepage-panel
    .admin-panel__header
      div
        p.admin-kicker Homepage
        h2.admin-panel__title Homepage publishing
        p.admin-panel__copy Select the live homepage record. New-homepage content is managed inside the home editor; legacy section order is available only for legacy records.
      - if @current_home
        span class="admin-pill admin-pill--#{@current_home.legacy? ? 'muted' : 'accent'}" = admin_home_variant_label(@current_home)
    - if @homes.any?
      .admin-panel-grid.admin-panel-grid--split
        .admin-panel-surface
          h3.admin-panel-surface__heading Live selection
          p.admin-panel-surface__copy Choose which record is published on the public site.
          = form_with url: set_primary_admin_homes_path, method: :patch, local: true, html: { data: { controller: "featured-home" }, class: "primary-home-form" } do
            .featured-home-list.list-group.list-group-flush data-featured-home-target="list" role="radiogroup"
              - @homes.each_with_index do |home, index|
                - checked = @current_home ? home == @current_home : index.zero?
                label.list-group-item.featured-home-list__item data-featured-home-target="item" data-action="click->featured-home#select keydown.enter->featured-home#select keydown.space->featured-home#select" data-key=home.id role="radio" tabindex="0" aria-checked=(checked ? "true" : "false") class=("is-active" if checked)
                  .featured-home-list__selector
                    = radio_button_tag :home_id, home.id, checked, class: "featured-home-list__input visually-hidden", data: { action: "change->featured-home#markActive" }
                    span.featured-home-list__indicator
                  .featured-home-list__body
                    span.featured-home-list__title = home.title.presence || "Home ##{home.id}"
                    .featured-home-list__details
                      span.featured-home-list__meta.badge = home.visible? ? "Published" : "Draft"
                      span.featured-home-list__meta.badge = admin_home_variant_label(home)
                      - if home.updated_at
                        span.featured-home-list__timestamp Updated #{time_ago_in_words(home.updated_at)} ago
            .featured-home-panel__actions
              button.btn.btn-gradient.btn-sm type="submit"
                i.fa-solid.fa-check-double.me-2 aria-hidden="true"
                | Publish selected home
              = link_to admin_homes_path, class: "btn btn-ghost btn-sm" do
                i.fa-solid.fa-table-list.me-2 aria-hidden="true"
                | Open home library
        .admin-panel-surface
          - if @current_home
            - if @current_home.legacy?
              .admin-panel-surface__eyebrow
                span.admin-pill.admin-pill--muted Legacy only
              h3.admin-panel-surface__heading Legacy section order
              p.admin-panel-surface__copy Reorder the legacy modules displayed beneath the hero slider. This control is not used by new-homepage records.
              = form_with model: @current_home, url: admin_home_path(@current_home), method: :patch, local: true, html: { data: { controller: "section-order" } } do |f|
                = f.hidden_field :section_order, value: @current_home.section_order_list.join(","), data: { section_order_target: "input" }
                .section-order-list data-section-order-target="list"
                  - @current_home.section_order_list.each do |key|
                    - label = { "gallery" => "Gallery", "about" => "About", "contact" => "Contact" }[key] || key.titleize
                    .section-order-item data-section-order-target="item" data-key=key
                      span.section-order-item__drag-icon
                        i.fa-solid.fa-grip-vertical aria-hidden="true"
                      span.section-order-item__label = label
                      .section-order-item__actions
                        button.btn.btn-link.btn-sm type="button" data-action="section-order#moveUp" data-direction="up" aria-label="Move section up"
                          i.fa-solid.fa-arrow-up aria-hidden="true"
                        button.btn.btn-link.btn-sm type="button" data-action="section-order#moveDown" data-direction="down" aria-label="Move section down"
                          i.fa-solid.fa-arrow-down aria-hidden="true"
                .featured-home-panel__actions
                  button.btn.btn-gradient.btn-sm type="submit"
                    i.fa-solid.fa-layer-group.me-2 aria-hidden="true"
                    | Save legacy order
                  = link_to edit_admin_home_path(@current_home), class: "btn btn-ghost btn-sm" do
                    i.fa-solid.fa-pen-to-square.me-2 aria-hidden="true"
                    | Edit homepage
            - else
              .admin-panel-surface__eyebrow
                span.admin-pill.admin-pill--accent New homepage
              h3.admin-panel-surface__heading Managed in homepage editor
              p.admin-panel-surface__copy Copy, gallery slots, reports, about and contacts belong to the home editor for this layout.
              .featured-home-panel__actions
                = link_to edit_admin_home_path(@current_home), class: "btn btn-gradient btn-sm" do
                  i.fa-solid.fa-pen-to-square.me-2 aria-hidden="true"
                  | Open homepage editor
          - else
            h3.admin-panel-surface__heading No live homepage yet
            p.admin-panel-surface__copy Create or publish a record to unlock the rest of the live-site workflow.
            .featured-home-panel__actions
              = link_to "Create home page", new_admin_home_path, class: "btn btn-primary btn-sm"
    - else
      .admin-empty-state
        h3.admin-empty-state__title No homepage records yet
        p.admin-empty-state__copy Create the first home record to publish either the legacy or new layout.
        .admin-empty-state__actions
          = link_to "Create homepage", new_admin_home_path, class: "btn btn-primary"

  section.card.section-card.admin-panel
    .admin-panel__header
      div
        p.admin-kicker Site settings
        h2.admin-panel__title Brand, public profile and email delivery
        p.admin-panel__copy Use compact panels with predictable spacing instead of one long settings page. Desktop keeps a two-column rhythm, tablet collapses to one, mobile prioritizes the form order.
    = form_with(model: @site_setting, url: admin_site_setting_path(@site_setting), local: true, html: { class: "settings-form admin-settings-form" }) do |f|
      .admin-settings-grid
        .admin-settings-card
          .admin-settings-card__header
            h3.admin-settings-card__title Brand assets
            p.admin-settings-card__copy Refresh the visuals shown in the admin shell, navigation and browser tabs.
          .admin-settings-card__body
            .brand-upload
              .brand-upload__item data-controller="logo-preview"
                h5.brand-upload__title Primary logo
                p.brand-upload__hint Displayed in navigation and admin
                - if @site_setting.logo.attached?
                  - logo_preview = @site_setting.logo.variable? ? @site_setting.logo.variant(resize_to_limit: [200, 200]) : @site_setting.logo
                  .brand-upload__preview data-logo-preview-target="currentPreview"
                    = image_tag logo_preview, class: "brand-upload__image", alt: "Current logo"
                    label.brand-upload__remove
                      = f.check_box :remove_logo, class: "form-check-input"
                      span Remove logo
                = f.file_field :logo, accept: "image/png,image/jpeg,image/svg+xml", class: "form-control", direct_upload: true, data: { action: "change->logo-preview#preview", logo_preview_target: "input" }
                .brand-upload__preview.brand-upload__preview--live data-logo-preview-target="preview" hidden=true
                  img.brand-upload__image data-logo-preview-target="image" alt="Selected logo preview"
                  div.brand-upload__meta
                    span.brand-upload__filename data-logo-preview-target="filename"
                    button.brand-upload__reset type="button" data-action="logo-preview#reset" Reset selection
                span.brand-upload__note Recommended 320×320px PNG or SVG

              hr

              .brand-upload__item
                h5.brand-upload__title Favicon
                p.brand-upload__hint Used in browser tabs and bookmarks
                - if @site_setting.favicon.attached?
                  - favicon_preview = @site_setting.favicon.variable? ? @site_setting.favicon.variant(resize_to_limit: [64, 64]) : @site_setting.favicon
                  .brand-upload__preview.brand-upload__preview--favicon
                    = image_tag favicon_preview, class: "brand-upload__image", alt: "Favicon"
                    label.brand-upload__remove
                      = f.check_box :remove_favicon, class: "form-check-input"
                      span Remove favicon
                = f.file_field :favicon, accept: "image/x-icon,image/png", class: "form-control", direct_upload: true
                span.brand-upload__note ICO or PNG 32×32px

        .admin-settings-card
          .admin-settings-card__header
            h3.admin-settings-card__title Public profile
            p.admin-settings-card__copy Site name, verification codes and social links used across the public site.
          .admin-settings-card__body
            .form-grid
              .form-grid__item
                = f.label :name_site, class: "form-label form-label--strong"
                = f.text_field :name_site, class: "form-control", placeholder: "Site display name"
              .form-grid__item
                = f.label :footer, class: "form-label form-label--strong"
                = f.text_field :footer, class: "form-control", placeholder: "Footer text"
              .form-grid__item
                = f.label :yn_verification_pri, class: "form-label form-label--strong"
                = f.text_field :yn_verification_pri, class: "form-control", placeholder: "Yandex verification primary"
              .form-grid__item
                = f.label :yn_verification_sec, class: "form-label form-label--strong"
                = f.text_field :yn_verification_sec, class: "form-control", placeholder: "Yandex verification secondary"
              .form-grid__item
                = f.label :tg_url, "Telegram URL", class: "form-label form-label--strong"
                = f.text_field :tg_url, class: "form-control", placeholder: "https://t.me/..."
              .form-grid__item
                = f.label :vk_url, "VK URL", class: "form-label form-label--strong"
                = f.text_field :vk_url, class: "form-control", placeholder: "https://vk.com/..."
              .form-grid__item
                = f.label :inst_url, "Instagram URL", class: "form-label form-label--strong"
                = f.text_field :inst_url, class: "form-control", placeholder: "https://instagram.com/..."
              .form-grid__item
                = f.label :fb_url, "Facebook URL", class: "form-label form-label--strong"
                = f.text_field :fb_url, class: "form-control", placeholder: "https://facebook.com/..."
              .form-grid__item.form-grid__item--full
                .input-card.input-card--switch
                  h5.input-card__title Pages
                  p.input-card__hint Future feature
                  .form-switch-row
                    .form-check.form-switch
                      = f.check_box :pages_enabled, class: "form-check-input input-card__switch", id: "site_setting_pages_enabled", disabled: true
                      = f.label :pages_enabled, "Pages enabled", class: "form-check-label", for: "site_setting_pages_enabled"
                  p.card-subtitle.text-muted.small.mt-2 Coming later. Pages workspace is locked for now.

        .admin-settings-card.admin-settings-card--full
          .admin-settings-card__header
            h3.admin-settings-card__title Email delivery
            p.admin-settings-card__copy SMTP credentials and security toggles used by outgoing mailers.
          .admin-settings-card__body
            .form-grid.form-grid--two-col
              .form-grid__item
                = f.label :email_contact, "Contact email", class: "form-label form-label--strong"
                = f.email_field :email_contact, class: "form-control", placeholder: "info@example.com"
              .form-grid__item
                = f.label :email_login, "SMTP login", class: "form-label form-label--strong"
                = f.text_field :email_login, class: "form-control"
              .form-grid__item
                = f.label :email_domain, "SMTP domain", class: "form-label form-label--strong"
                = f.text_field :email_domain, class: "form-control"
              .form-grid__item
                = f.label :email_password, "SMTP password", class: "form-label form-label--strong"
                = f.password_field :email_password, class: "form-control"
              .form-grid__item
                = f.label :email_address, "SMTP address", class: "form-label form-label--strong"
                = f.text_field :email_address, class: "form-control", placeholder: "smtp.example.com"
              .form-grid__item
                = f.label :email_port, "SMTP port", class: "form-label form-label--strong"
                = f.number_field :email_port, class: "form-control", placeholder: "587"
              .form-grid__item.form-grid__item--full
                .input-card.input-card--switch
                  h5.input-card__title TLS
                  p.input-card__hint Enable TLS for outgoing mail
                  .form-switch-row
                    .form-check.form-switch
                      = f.check_box :email_tls, class: "form-check-input input-card__switch"
                      = f.label :email_tls, "TLS enabled", class: "form-check-label"
              .form-grid__item.form-grid__item--full
                .input-card.input-card--switch
                  h5.input-card__title SSL
                  p.input-card__hint Enable SSL when required by provider
                  .form-switch-row
                    .form-check.form-switch
                      = f.check_box :email_ssl, class: "form-check-input input-card__switch"
                      = f.label :email_ssl, "SSL enabled", class: "form-check-label"

      .settings-form-actions
        button.btn.btn-gradient type="submit"
          i.fa-solid.fa-floppy-disk.me-2 aria-hidden="true"
          | Save site settings
