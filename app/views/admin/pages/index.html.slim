- total_words = @pages.sum { |page| page.body.to_s.split.size }
- longest_page = @pages.max_by { |page| page.body.to_s.length }
- stats = [{ label: "Pages", value: @pages.size, note: "Standalone content records", tone: "accent" }, { label: "Words", value: total_words, note: @pages.any? ? "Across all static pages" : "No content yet", tone: @pages.any? ? "muted" : "warning" }, { label: "Longest page", value: longest_page ? longest_page.body.to_s.split.size : 0, note: longest_page ? longest_page.title : "No pages yet", tone: longest_page ? "accent" : "muted" }]

section.admin-workspace
  .admin-workspace__header
    .admin-workspace__header-copy
      p.admin-kicker Pages
      h1.admin-workspace__title Static pages and long-form copy
      p.admin-workspace__lead Standalone pages are now presented as readable content cards with word-count signals, not as an oversized table that hides the actual copy quality.
    .admin-workspace__actions
      = link_to "New page", new_admin_page_path, class: "btn btn-primary"

  .admin-overview-grid.admin-overview-grid--tight.admin-overview-grid--three
    - stats.each do |stat|
      article.card.section-card.admin-stat-card
        span.admin-stat-card__label = stat[:label]
        strong.admin-stat-card__value = stat[:value]
        span class="admin-pill admin-pill--#{stat[:tone]}" = stat[:note]

  - if @pages.any?
    .admin-record-grid.admin-record-grid--two
      - @pages.each do |page|
        - clean_body = strip_tags(page.body.to_s)
        article.card.section-card.admin-record-card
          .admin-record-card__head
            .admin-record-card__title-group
              p.admin-record-card__eyebrow = "Page ##{page.id}"
              h2.admin-record-card__title = page.title
              p.admin-record-card__summary = truncate(clean_body, length: 180)
          .admin-record-card__metric-grid
            .admin-record-card__metric
              span.admin-record-card__metric-label Words
              strong.admin-record-card__metric-value = clean_body.split.size
            .admin-record-card__metric
              span.admin-record-card__metric-label Characters
              strong.admin-record-card__metric-value = clean_body.length
            .admin-record-card__metric
              span.admin-record-card__metric-label Updated
              strong.admin-record-card__metric-value = l(page.updated_at, format: :short)
          .admin-record-card__footer
            .admin-record-card__meta
              span Static page
            .table-actions
              = link_to "Edit", edit_admin_page_path(page), class: "btn btn-outline-primary btn-sm"
              = link_to "Delete", admin_page_path(page), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm"
  - else
    .card.section-card.admin-empty-state
      h2.admin-empty-state__title No static pages yet
      p.admin-empty-state__copy Create a page to manage standalone site copy without touching homepage records.
      .admin-empty-state__actions
        = link_to "Create page", new_admin_page_path, class: "btn btn-primary"
