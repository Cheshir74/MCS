= form_for [:admin, page], html: { class: "admin-editor admin-editor--page admin-pages-form" } do |f|
  - if page.errors.any?
    .admin-form-errors
      - page.errors.full_messages.each do |msg|
        .alert.alert-danger.mb-3 = msg

  section.admin-workspace
    .admin-workspace__header
      .admin-workspace__header-copy
        p.admin-kicker Pages
        h1.admin-workspace__title = page.persisted? ? "Edit page" : "New page"
        p.admin-workspace__lead This editor stays locked for now, but the structure is already reduced to a compact content draft.
      .admin-workspace__actions
        = link_to "Back to list", admin_pages_path, class: "btn btn-outline-secondary"
        = button_tag page.persisted? ? "Save page" : "Create page", type: "button", class: "btn btn-primary", disabled: true, title: "Coming later"

    .card.section-card.admin-list-card.admin-pages-editor
      .admin-list-card__head
        .admin-list-card__copy
          h2.admin-list-card__title Content draft
          p.admin-list-card__meta Title and body only. The editor will expand when Pages are enabled.

      .admin-future-lock.admin-pages-lock
        fieldset.admin-future-lock__content.admin-future-lock__content--fieldset disabled=true
          .admin-pages-shell
            .admin-pages-shell__field
              label.admin-pages-shell__label for="page_title" Title
              = f.text_field :title, class: "form-control admin-pages-shell__control", placeholder: "Page title"

            .admin-pages-shell__field.admin-pages-shell__field--body
              label.admin-pages-shell__label for="page_body" Body
              = f.text_area :body, class: "form-control admin-pages-shell__control admin-pages-shell__control--body", rows: 8, placeholder: "Page content"

        .admin-future-lock__overlay
          .card.section-card.admin-future-lock__card
            p.admin-kicker Future feature
            h2.admin-future-lock__title Pages editor
            p.admin-future-lock__copy Coming later.
