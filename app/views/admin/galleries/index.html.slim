div class="page-header"
  h3 class="page-headline" Gallery List
  div class="page-header__meta"
    span.page-header__chip Content Ops
    span.page-header__text Manage gallery records and connected media

div class="row"
  div class="col-sm-12"
    div class="card section-card"
      .card-header.d-flex.justify-content-between.align-items-center
        span Galleries list
        = link_to 'New gallery', new_admin_gallery_path, class: 'btn btn-outline-primary btn-sm'
      .card-body.px-0.overflow-auto
        table class="table table-hover align-middle mb-0"
          thead class="bg-light text-muted"
            tr
              th scope="col" class="text-nowrap px-4" #
              th scope="col" class="text-nowrap" Name
              th scope="col" class="text-nowrap text-end px-4" Actions
          tbody
            - @galleries.each_with_index do |gallery, index|
              tr
                td class="px-4 text-muted"= index + 1
                td
                  strong= gallery.name
                td class="text-end px-4"
                  = link_to 'Edit', edit_admin_gallery_path(gallery), class: 'btn btn-outline-primary btn-sm me-2'
                  = link_to 'Delete', admin_gallery_path(gallery), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-outline-danger btn-sm'
