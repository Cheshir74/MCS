.row.row-cols-2.sortable id="lightgallery"
  - if @home.images.attached?
    - @home.images.each do |image|
      .column data-id='#{image.id}'
        .box-img
          = label_tag "delete_img_ids_#{image.id}", nil, class: 'checkbox-label' do
            = check_box_tag "delete_img_ids[]", image.id, false, id: "delete_img_ids_#{image.id}", class: 'checkbox-input'
            span.check
        .item data-src="#{url_for(image.variant(resize_to_limit: [2000, 1200]))}"
          a href="#{url_for(image.variant(resize_to_limit: [1000, 670]))}"
            = image_tag image.variant(resize_to_limit: [210, 210])
        
        .card-img-overlay
          = link_to delete_image_attachment_admin_home_path(@home, image_id: image.id), 
                    method: :delete, 
                    data: { turbo_confirm: 'Are you sure?', turbo_method: :delete }, 
                    class: 'img-btn-edit' do
            i.fas.fa-trash
        span.icon-focus
  - else
    p There are no images