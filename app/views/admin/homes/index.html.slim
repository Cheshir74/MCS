div class="page-header"
  h3 class="page-headline" Home Pages
  div class="page-header__meta"
    span.page-header__chip Landing
    span.page-header__text Configure homepage layouts and hero content

div class="row"
  div class="col-sm-12"
    div class="card section-card"
      .card-header.d-flex.justify-content-between.align-items-center
        span Home pages list
        = link_to 'New home page', new_admin_home_path, class: 'btn btn-outline-primary btn-sm'
      .card-body.px-0.overflow-auto
        table class="table table-hover align-middle mb-0"
          thead class="bg-light text-muted"
            tr
              th scope="col" class="text-nowrap px-4" #
              th scope="col" class="text-nowrap" Title
              th scope="col" class="text-nowrap" Intro
              th scope="col" class="text-nowrap text-end px-4" Actions
          tbody
            - @homes.each_with_index do |home, index|
              tr
                td class="px-4 text-muted"= index + 1
                td
                  strong= home.title
                td
                  = truncate(home.body, length: 80)
                td class="text-end px-4"
                  = link_to 'Edit', edit_admin_home_path(home), class: 'btn btn-outline-primary btn-sm me-2'
                  = link_to 'Delete', admin_home_path(home), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-outline-danger btn-sm'
