- galleries ||= []
- design_options = [["Legacy", "legacy"], ["New", "editorial"]]
- nav_sections = [{ id: "home-publish", title: "Publish", scope: "shared" }, { id: "home-seo", title: "SEO", scope: "shared" }, { id: "home-media", title: "Media", scope: "shared" }, { id: "home-legacy-hero", title: "Old hero", scope: "legacy" }, { id: "home-legacy-about", title: "Old about", scope: "legacy" }, { id: "home-editorial-hero", title: "New hero", scope: "editorial" }, { id: "home-editorial-reports", title: "Reports", scope: "editorial" }, { id: "home-editorial-about", title: "New about", scope: "editorial" }, { id: "home-editorial-contacts", title: "Contacts", scope: "editorial" }, { id: "home-editorial-galleries", title: "Slots", scope: "editorial" }]
- hero_image_count = home.images.attachments.size
- active_hero_attachment = home.ordered_images.first
- legacy_extra_hero_count = [hero_image_count - 1, 0].max
- assigned_editorial_galleries = Home::EDITORIAL_GALLERY_FIELDS.count { |field| home.public_send(field).present? }
- summary_rows = [["Status", home.visible? ? "Published" : "Draft", home.visible? ? "success" : "muted"], ["Mode", admin_home_variant_label(home), home.editorial? ? "accent" : "muted"], ["Hero media", "#{hero_image_count} file#{'s' unless hero_image_count == 1}", "muted"], ["Portrait", home.image.attached? ? "Attached" : "Missing", home.image.attached? ? "success" : "warning"], ["New slots", "#{assigned_editorial_galleries}/7", assigned_editorial_galleries.positive? ? "accent" : "muted"]]
- editorial_gallery_slots = [{ field: :editorial_lead_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_lead_gallery_id], area: "lead", badge: "Lead", hint: "Крупный левый блок. Лучше ставить серию с сильным титульным кадром и полноценным описанием." }, { field: :editorial_feature_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_feature_gallery_id], area: "feature", badge: "Accent", hint: "Высокая правая карточка. Подходит для второй по важности истории с заметным кадром." }, { field: :editorial_compact_left_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_compact_left_gallery_id], area: "compact-left", badge: "Compact", hint: "Малый блок под акцентной серией. Хорошо работает для короткой истории или backstage." }, { field: :editorial_compact_right_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_compact_right_gallery_id], area: "compact-right", badge: "Compact", hint: "Второй малый блок в правой колонке. Используйте для ритма и поддержки основной пары." }, { field: :editorial_series_first_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_series_first_gallery_id], area: "series-first", badge: "Mini", hint: "Нижний мини-блок. Берет overlay-заголовок и теги из карточки галереи." }, { field: :editorial_series_second_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_series_second_gallery_id], area: "series-second", badge: "Mini", hint: "Второй мини-блок в нижнем ряду. Лучше ставить контрастную по содержанию серию." }, { field: :editorial_series_third_gallery_id, label: Home::EDITORIAL_GALLERY_LABELS[:editorial_series_third_gallery_id], area: "series-third", badge: "Mini", hint: "Третий мини-блок в нижнем ряду. Работает как завершающий акцент под главной серией." }]
- field_example = ->(value, fallback = nil) { strip_tags(value.to_s).squish.presence || fallback.to_s }
- editorial_example = ->(key) { field_example.call(home.editorial_content(key), Home::EDITORIAL_DEFAULTS[key.to_sym]) }

= form_for [:admin, home], html: { class: "admin-editor admin-editor--home", data: { controller: "home-editor" } } do |f|
  - if home.errors.any?
    .admin-form-errors
      - home.errors.full_messages.each do |msg|
        .alert.alert-danger.mb-3 = msg

  .admin-editor__layout
    aside.admin-editor__rail
      .card.section-card.admin-editor__rail-card
        .admin-editor__rail-head
          .admin-editor__rail-copy-group
            p.admin-kicker Homepage
            h4.admin-editor__rail-title Quick actions
          span.admin-pill.admin-pill--accent data-home-editor-target="modeBadge" = admin_home_variant_mode_label(home)
        p.admin-editor__rail-copy data-home-editor-target="modeDescription"
          - if home.editorial?
            | You are editing the new homepage. Shared sections stay visible, legacy blocks can be hidden with the filter.
          - else
            | You are editing the legacy homepage. Shared sections stay visible, new sections can be hidden with the filter.
        .admin-editor__rail-actions
          = f.submit home.persisted? ? "Save homepage" : "Create homepage", class: "btn btn-primary"
          = link_to "Back to list", admin_homes_path, class: "btn btn-outline-secondary"
        .admin-editor__filter
          span.admin-editor__filter-label Show
          .admin-segmented
            button.admin-segmented__button.is-active type="button" data-home-editor-target="filterButton" data-filter-mode="current" data-action="home-editor#showCurrent" aria-pressed="true"
              | Current mode
            button.admin-segmented__button type="button" data-home-editor-target="filterButton" data-filter-mode="all" data-action="home-editor#showAll" aria-pressed="false"
              | All sections

      .admin-editor__rail-sticky
        .card.section-card.admin-editor__rail-card.admin-editor__rail-card--nav
          .card-header
            h4.card-title
              span.card-chip Navigate
              |  Sections
          nav.admin-editor__nav
            - nav_sections.each do |item|
              a.admin-editor__nav-link href="##{item[:id]}" data-action="click->home-editor#jumpToSection" data-home-editor-target="navItem" data-scope=item[:scope]
                span.admin-editor__nav-title = item[:title]

        .card.section-card.admin-editor__rail-card
          .card-header
            h4.card-title
              span.card-chip Summary
              |  Current record
            p.card-subtitle.text-muted.small Quick status snapshot before publishing
          .admin-summary-list
            - summary_rows.each do |label, value, tone|
              .admin-summary-list__item
                span.admin-summary-list__label = label
                span class="admin-summary-list__value admin-summary-list__value--#{tone}" = value

    .admin-editor__main
      section.card.section-card.admin-editor__section id="home-publish" data-home-editor-target="section" data-scope="shared"
        .card-header
          h4.card-title
            span.card-chip Publish
            |  Design & visibility
          p.card-subtitle.text-muted.small Choose which design this record uses and how it behaves on the public site
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card
              h5.input-card__title Active design
              p.input-card__hint Select which layout this home record publishes on the public site
              = f.select :design_variant, options_for_select(design_options, home.design_variant), {}, class: "form-select input-card__control", data: { controller: "select-menu", home_editor_target: "variant", action: "change->home-editor#syncDesign" }
            .input-card
              h5.input-card__title Legacy featured gallery
              p.input-card__hint Used only by the old homepage layout
              = f.select :gallery_id, options_for_select(editorial_gallery_options(galleries), home.gallery_id), {}, class: "form-select input-card__control", data: { controller: "select-menu" }
            .input-card.input-card--switch
              - visible_id = dom_id(home, :visible)
              h5.input-card__title Public visibility
              p.input-card__hint Only one homepage should be published at a time
              .form-switch-row.mt-2
                .form-check.form-switch
                  = f.check_box :visible, class: "form-check-input input-card__switch", id: visible_id
                  = f.label :visible, "Publish this home", class: "form-check-label", for: visible_id
            .input-card.input-card--switch
              - visible_cf_id = dom_id(home, :visible_cf)
              h5.input-card__title Public contact form
              p.input-card__hint Shows on the legacy homepage and below contacts on the new homepage
              .form-switch-row.mt-2
                .form-check.form-switch
                  = f.check_box :visible_cf, class: "form-check-input input-card__switch", id: visible_cf_id
                  = f.label :visible_cf, "Show public contact form", class: "form-check-label", for: visible_cf_id

      section.card.section-card.admin-editor__section id="home-seo" data-home-editor-target="section" data-scope="shared"
        .card-header
          h4.card-title
            span.card-chip SEO
            |  Homepage snippet
          p.card-subtitle.text-muted.small Optional title and description for search engines and social previews
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card
              h5.input-card__title SEO title
              p.input-card__hint Fallback: hero title or legacy title
              = f.text_field :seo_title, class: "form-control input-card__control", maxlength: 70, placeholder: field_example.call(home.editorial? ? home.editorial_content(:hero_title) : home.title, "Homepage title")
            .input-card.admin-editor__full
              h5.input-card__title SEO description
              p.input-card__hint Recommended length: 120-155 characters
              = f.text_area :seo_description, class: "form-control input-card__control", rows: 3, maxlength: 180, placeholder: field_example.call(home.editorial? ? home.editorial_content(:hero_body) : home.body, "Short search description")

      section.card.section-card.admin-editor__section id="home-media" data-home-editor-target="section" data-scope="shared"
        .card-header
          h4.card-title
            span.card-chip Media
            |  Hero assets
          p.card-subtitle.text-muted.small Legacy keeps the slider workflow. New mode works with one active fullscreen hero frame.
        .card-body
          .admin-media-mode data-home-editor-target="variantPanel" data-variant-panel="legacy" hidden=home.editorial?
            .home-media-grid
              .home-media-grid__dropzone
                label.form-label.form-label--strong Upload hero images
                .dropzone.dropzone-default.dropzone-modern.dz-clickable data-controller="dropzone"
                  = f.file_field :images, multiple: true, as: :file, direct_upload: true, "data-dropzone-target": "input"
                  .dropzone-msg.dz-message.needsclick
                    i.fa-solid.fa-cloud-arrow-up.dropzone-icon aria-hidden="true"
                    span.dropzone-title Drag files here or click to browse
                    span.dropzone-subtitle.text-muted.small Every uploaded file joins the legacy slider
              .home-media-grid__info
                .admin-note-stack
                  .admin-note
                    strong Slider logic
                    p.mb-0 Legacy layout still uses every uploaded file as the hero slider.
                  .admin-note
                    strong Order matters
                    p.mb-0 Drag the library below to control slide order and which frame becomes first if you later switch to the new homepage.
                  .admin-note
                    strong Editorial compatibility
                    p.mb-0 The first ordered frame is reused as the new homepage hero until you upload a dedicated editorial frame.

            - if home.images.present?
              .section-header.admin-section-heading
                div
                  h5.section-header__title Hero media library
                  p.section-header__meta Select, reorder or remove uploaded hero assets
              = render "admin/homes/images", home: home

          .admin-media-mode data-home-editor-target="variantPanel" data-variant-panel="editorial" hidden=home.legacy?
            .admin-hero-frame
              .admin-hero-frame__preview
                - if active_hero_attachment.present?
                  = image_tag active_hero_attachment.variant(resize_to_fill: [920, 560]), class: "admin-hero-frame__image", alt: ""
                  .admin-hero-frame__meta
                    strong Active hero frame
                    p.mb-0 This image is used as the fullscreen hero background on the new homepage.
                    - if legacy_extra_hero_count.positive?
                      p.admin-hero-frame__subtle.mb-0 = "#{legacy_extra_hero_count} additional slider frame#{'s' unless legacy_extra_hero_count == 1} stay attached for the legacy layout."
                  - if home.persisted?
                    .admin-hero-frame__actions
                      = link_to delete_image_attachment_admin_home_path(home, image_id: active_hero_attachment.id), data: { turbo_method: :delete, turbo_confirm: "Remove the current hero frame?" }, class: "btn btn-outline-danger btn-sm" do
                        i.fa-solid.fa-trash.me-1 aria-hidden="true"
                        | Remove current frame
                - else
                  .admin-hero-frame__empty
                    i.fa-regular.fa-image aria-hidden="true"
                    strong No hero frame yet
                    p.mb-0 Upload one image for the new homepage hero.
              .admin-hero-frame__side
                .home-media-grid__dropzone
                  label.form-label.form-label--strong Replace active hero frame
                  .dropzone.dropzone-default.dropzone-modern.dz-clickable data-controller="dropzone" data-dropzone-max-files="1"
                    = file_field_tag "home[editorial_hero_image]", direct_upload: true, "data-dropzone-target": "input"
                    .dropzone-msg.dz-message.needsclick
                      i.fa-solid.fa-cloud-arrow-up.dropzone-icon aria-hidden="true"
                      span.dropzone-title Drag one image here or click to browse
                      span.dropzone-subtitle.text-muted.small The uploaded frame becomes first and replaces the current editorial hero
                .admin-note-stack
                  .admin-note
                    strong New-layout logic
                    p.mb-0 Only one active hero frame is used on the new homepage.
                  .admin-note
                    strong Legacy assets
                    p.mb-0 Extra slider frames are preserved automatically, but managed only in legacy mode.

          .admin-subsection
            h5.admin-subsection__title Portrait / about photo
            p.admin-subsection__hint Shared portrait used by the legacy about block and the new profile section.
            .input-card.admin-media-card.admin-media-card--portrait
              .dropzone.dropzone-default.dropzone-modern.dz-clickable data-controller="dropzone" data-dropzone-max-files="1"
                = f.file_field :image, as: :file, direct_upload: true, "data-dropzone-target": "input"
                .dropzone-msg.dz-message.needsclick
                  i.fa-solid.fa-cloud-arrow-up.dropzone-icon aria-hidden="true"
                  span.dropzone-title Drag file here or click to browse
                  span.dropzone-subtitle.text-muted.small Square or portrait crops work best
              - if home.image.attached?
                .admin-media-preview.mt-3
                  = image_tag home.image.variant(resize_to_limit: [220, 220]), class: "admin-media-preview__image", alt: "Current portrait"
                  .admin-media-preview__meta
                    span.admin-media-preview__label Current portrait
                    = link_to delete_photo_attachment_admin_home_url(home), data: { turbo_method: :delete, turbo_confirm: "Remove the current portrait?" }, class: "btn btn-outline-danger btn-sm" do
                      i.fa-solid.fa-trash.me-2 aria-hidden="true"
                      | Remove

      section.card.section-card.admin-editor__section id="home-legacy-hero" data-home-editor-target="section" data-scope="legacy"
        .card-header
          h4.card-title
            span.card-chip Legacy
            |  Hero block
          p.card-subtitle.text-muted.small Fields used only by the current legacy homepage
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card
              h5.input-card__title Title
              p.input-card__hint Headline for the old slider layout
              = f.text_field :title, class: "form-control input-card__control", placeholder: field_example.call(home.title, "Your headline")
            .input-card
              h5.input-card__title Intro text
              p.input-card__hint Short teaser shown under the headline
              = f.text_area :body, class: "form-control input-card__control", rows: 4, placeholder: field_example.call(home.body, "Legacy intro")

      section.card.section-card.admin-editor__section id="home-legacy-about" data-home-editor-target="section" data-scope="legacy"
        .card-header
          h4.card-title
            span.card-chip Legacy
            |  About section
          p.card-subtitle.text-muted.small Biography block and portrait for the old homepage layout
        .card-body
          .admin-section-grid
            .input-card
              h5.input-card__title Block title
              p.input-card__hint Heading shown above the biography
              = f.text_field :title_block1, class: "form-control input-card__control", placeholder: field_example.call(home.title_block1, "About me")

            = render "admin/shared/rich_text_field",
              form: f,
              field: :body_block1,
              title: "Bio text",
              hint: "Rich text used only in the legacy about section",
              placeholder: field_example.call(home.body_block1, "Share your story")

      section.card.section-card.admin-editor__section id="home-editorial-hero" data-home-editor-target="section" data-scope="editorial"
        .card-header
          h4.card-title
            span.card-chip New
            |  Hero & strip
          p.card-subtitle.text-muted.small Core copy for the new homepage hero
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card
              h5.input-card__title Eyebrow
              p.input-card__hint Small line above the headline
              = f.text_field :hero_eyebrow, class: "form-control input-card__control", placeholder: editorial_example.call(:hero_eyebrow)
            .input-card
              h5.input-card__title Hero title
              p.input-card__hint Main heading on the new hero card
              = f.text_field :hero_title, class: "form-control input-card__control", placeholder: editorial_example.call(:hero_title)
            = render "admin/shared/rich_text_field",
              form: f,
              field: :hero_body,
              title: "Hero body",
              hint: "Lead paragraph on the first screen",
              placeholder: editorial_example.call(:hero_body),
              input_card_class: "admin-editor__full"
            .input-card.admin-editor__full
              h5.input-card__title Headline strip
              p.input-card__hint Running line below the hero section
              = f.text_field :headline_strip_text, class: "form-control input-card__control", placeholder: editorial_example.call(:headline_strip_text)

      section.card.section-card.admin-editor__section id="home-editorial-reports" data-home-editor-target="section" data-scope="editorial"
        .card-header
          h4.card-title
            span.card-chip New
            |  Reports section
          p.card-subtitle.text-muted.small Copy above and around the gallery composition block
        .card-body
          .admin-section-grid.admin-section-grid--two
            = render "admin/shared/rich_text_field",
              form: f,
              field: :reports_body,
              title: "Intro paragraph",
              placeholder: editorial_example.call(:reports_body),
              input_card_class: "admin-editor__full"
            .input-card.admin-editor__full.input-card--split
              .input-card__split-column.input-card__split-column--narrow
                h5.input-card__title Intro block
                p.input-card__hint Left descriptive block above the gallery cards
                = f.text_field :reports_intro_title, class: "form-control input-card__control", placeholder: editorial_example.call(:reports_intro_title)
              .input-card__split-column
                = render "admin/shared/rich_text_field",
                  form: f,
                  field: :reports_intro_text,
                  title: "Intro text",
                  hint: "Supporting copy for the left descriptive block",
                  placeholder: editorial_example.call(:reports_intro_text),
                  input_card_class: "input-card--nested input-card--split-editor",
                  editor_class: "rich-text__editor--compact"
            .input-card.admin-editor__full.input-card--split
              .input-card__split-column.input-card__split-column--narrow
                h5.input-card__title Focus block
                = f.text_field :reports_focus_title, class: "form-control input-card__control", placeholder: editorial_example.call(:reports_focus_title)
              .input-card__split-column
                = render "admin/shared/rich_text_field",
                  form: f,
                  field: :reports_focus_text,
                  title: "Focus text",
                  placeholder: editorial_example.call(:reports_focus_text),
                  input_card_class: "input-card--nested input-card--split-editor",
                  editor_class: "rich-text__editor--compact"
            .input-card.admin-editor__full.input-card--split
              .input-card__split-column.input-card__split-column--narrow
                h5.input-card__title Delivery block
                = f.text_field :reports_delivery_title, class: "form-control input-card__control", placeholder: editorial_example.call(:reports_delivery_title)
              .input-card__split-column
                = render "admin/shared/rich_text_field",
                  form: f,
                  field: :reports_delivery_text,
                  title: "Delivery text",
                  placeholder: editorial_example.call(:reports_delivery_text),
                  input_card_class: "input-card--nested input-card--split-editor",
                  editor_class: "rich-text__editor--compact"
            .input-card.admin-editor__full.input-card--split
              .input-card__split-column.input-card__split-column--narrow
                h5.input-card__title Result block
                = f.text_field :reports_result_title, class: "form-control input-card__control", placeholder: editorial_example.call(:reports_result_title)
              .input-card__split-column
                = render "admin/shared/rich_text_field",
                  form: f,
                  field: :reports_result_text,
                  title: "Result text",
                  placeholder: editorial_example.call(:reports_result_text),
                  input_card_class: "input-card--nested input-card--split-editor",
                  editor_class: "rich-text__editor--compact"

      section.card.section-card.admin-editor__section id="home-editorial-about" data-home-editor-target="section" data-scope="editorial"
        .card-header
          h4.card-title
            span.card-chip New
            |  About section
          p.card-subtitle.text-muted.small Main copy, aside facts and metrics for the new profile block
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card.admin-editor__full
              h5.input-card__title Title
              = f.text_field :about_title, class: "form-control input-card__control", placeholder: editorial_example.call(:about_title)
            = render "admin/shared/rich_text_field",
              form: f,
              field: :about_body,
              title: "Main paragraph",
              placeholder: editorial_example.call(:about_body),
              input_card_class: "admin-editor__full"
            = render "admin/shared/rich_text_field",
              form: f,
              field: :about_body_secondary,
              title: "Secondary paragraph",
              placeholder: editorial_example.call(:about_body_secondary),
              input_card_class: "admin-editor__full"
            .input-card.admin-editor__full
              h5.input-card__title Quote
              = f.text_area :about_quote, class: "form-control input-card__control", rows: 3, placeholder: editorial_example.call(:about_quote)
            .input-card
              h5.input-card__title Aside top line
              p.input-card__hint Small line at the top of the right dark card
              = f.text_field :about_aside_index, class: "form-control input-card__control", placeholder: editorial_example.call(:about_aside_index)
            .input-card
              h5.input-card__title Aside heading
              p.input-card__hint Main title inside the right dark card
              = f.text_field :about_aside_title, class: "form-control input-card__control", placeholder: editorial_example.call(:about_aside_title)
            = render "admin/shared/rich_text_field",
              form: f,
              field: :about_aside_text,
              title: "Aside body",
              placeholder: editorial_example.call(:about_aside_text),
              hint: "Text inside the right dark card, above the compact pairs",
              input_card_class: "admin-editor__full",
              editor_class: "rich-text__editor--compact"

          .admin-subsection
            h5.admin-subsection__title Right card: compact pairs
            p.admin-subsection__hint Three short pairs inside the right dark card, under the aside text. Good pattern: `Подход -> Редакционно / документально`.
            .admin-section-grid.admin-section-grid--three
              - 3.times do |index|
                - number = index + 1
                .input-card
                  h5.input-card__title = "Pair #{number}"
                  p.input-card__hint Small label first, highlighted value second
                  = f.text_field :"about_fact_#{number}_label", class: "form-control input-card__control mb-2", placeholder: editorial_example.call(:"about_fact_#{number}_label")
                  = f.text_field :"about_fact_#{number}_value", class: "form-control input-card__control", placeholder: editorial_example.call(:"about_fact_#{number}_value")

          .admin-subsection
            h5.admin-subsection__title Bottom cards: metrics
            p.admin-subsection__hint Four cards under the right dark panel. Top line is a short value like `12+`, `24h` or `Live`, bottom line is the explanation.
            .admin-section-grid.admin-section-grid--two
              - 4.times do |index|
                - number = index + 1
                .input-card
                  h5.input-card__title = "Metric card #{number}"
                  p.input-card__hint Short value above, explanation below
                  = f.text_field :"about_metric_#{number}_value", class: "form-control input-card__control mb-2", placeholder: editorial_example.call(:"about_metric_#{number}_value")
                  = f.text_area :"about_metric_#{number}_label", class: "form-control input-card__control", rows: 3, placeholder: editorial_example.call(:"about_metric_#{number}_label")

      section.card.section-card.admin-editor__section id="home-editorial-contacts" data-home-editor-target="section" data-scope="editorial"
        .card-header
          h4.card-title
            span.card-chip New
            |  Contact section
          p.card-subtitle.text-muted.small Text block and contact-card labels for the right-side booking panel
        .card-body
          .admin-section-grid.admin-section-grid--two
            .input-card
              h5.input-card__title Eyebrow
              = f.text_field :contacts_eyebrow, class: "form-control input-card__control", placeholder: editorial_example.call(:contacts_eyebrow)
            .input-card
              h5.input-card__title Card eyebrow
              = f.text_field :contacts_card_eyebrow, class: "form-control input-card__control", placeholder: editorial_example.call(:contacts_card_eyebrow)
            .input-card.admin-editor__full
              h5.input-card__title Title
              = f.text_area :contacts_title, class: "form-control input-card__control", rows: 3, placeholder: editorial_example.call(:contacts_title)
            = render "admin/shared/rich_text_field",
              form: f,
              field: :contacts_body,
              title: "Body",
              placeholder: editorial_example.call(:contacts_body),
              input_card_class: "admin-editor__full"
            .input-card
              h5.input-card__title Location value
              = f.text_field :contacts_location_value, class: "form-control input-card__control", placeholder: editorial_example.call(:contacts_location_value)
            .input-card
              h5.input-card__title Phone value
              = f.text_field :contacts_phone_value, class: "form-control input-card__control", placeholder: editorial_example.call(:contacts_phone_value)
            .input-card
              h5.input-card__title Email value
              = f.email_field :contacts_email_value, class: "form-control input-card__control", placeholder: editorial_example.call(:contacts_email_value)

      section.card.section-card.admin-editor__section id="home-editorial-galleries" data-home-editor-target="section" data-scope="editorial"
        .card-header
          h4.card-title
            span.card-chip New
            |  Homepage gallery slots
          p.card-subtitle.text-muted.small Choose which galleries feed the new homepage composition
        .card-body
          .admin-note-stack
            .admin-note
              strong Layout logic
              p.mb-0 Главная повторяет реальную композицию публичной страницы: lead слева, акцент и compact-блоки справа, три mini-карточки снизу.
            .admin-note
              strong Gallery data source
              p.mb-0 Обложка, заголовки, подписи, overlay и теги подтягиваются из выбранной галереи. Здесь вы управляете только расстановкой.
          .admin-slots-grid
            - editorial_gallery_slots.each do |slot|
              .admin-slot-card class="admin-slot-card--#{slot[:area]}"
                .admin-slot-card__head
                  span.admin-slot-card__badge = slot[:badge]
                  h5.admin-slot-card__title = slot[:label]
                p.admin-slot-card__hint = slot[:hint]
                = f.select slot[:field], options_for_select(editorial_gallery_options(galleries), home.public_send(slot[:field])), {}, class: "form-select input-card__control admin-slot-card__control", data: { controller: "select-menu" }

  .form-actions.mt-4.admin-editor__footer-actions
    = f.submit home.persisted? ? "Save homepage" : "Create homepage", class: "btn btn-primary"
    = link_to "Cancel", admin_homes_path, class: "btn btn-outline-secondary"
