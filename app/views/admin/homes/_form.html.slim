- galleries ||= []
- design_options = [["Старый дизайн", "legacy"], ["Новый editorial", "editorial"]]

= form_for [:admin, home] do |f|
  - if home.errors.any?
    - home.errors.full_messages.each do |msg|
      .alert.alert-danger.mb-3 = msg

  .home-settings
    .home-settings__column.home-settings__column--primary
      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Publish
            |  Design & visibility
          p.card-subtitle.text-muted.small Choose which design this record uses and how it appears on the public site
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Variant
                p.input-card__hint Старый и новый дизайн живут в одной записи и переключаются здесь
                = f.select :design_variant, options_for_select(design_options, home.design_variant), {}, class: "form-select input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Legacy gallery
                p.input-card__hint Used only by the old home layout
                = f.select :gallery_id, options_for_select(editorial_gallery_options(galleries), home.gallery_id), {}, class: "form-select input-card__control"
            .col-12.col-md-6
              - visible_id = dom_id(home, :visible)
              .input-card.input-card--switch
                h5.input-card__title Public visibility
                p.input-card__hint Only one home record should be published at a time
                .form-switch-row.mt-2
                  .form-check.form-switch
                    = f.check_box :visible, class: "form-check-input input-card__switch", id: visible_id
                    = f.label :visible, "Publish this home", class: "form-check-label", for: visible_id
            .col-12.col-md-6
              - visible_cf_id = dom_id(home, :visible_cf)
              .input-card.input-card--switch
                h5.input-card__title Legacy contact form
                p.input-card__hint Used only in the old homepage layout
                .form-switch-row.mt-2
                  .form-check.form-switch
                    = f.check_box :visible_cf, class: "form-check-input input-card__switch", id: visible_cf_id
                    = f.label :visible_cf, "Show legacy contact form", class: "form-check-label", for: visible_cf_id

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Media
            |  Hero assets
          p.card-subtitle.text-muted.small Home hero slider for legacy layout and first frame for the new editorial hero
        .card-body
          .home-media-grid
            .home-media-grid__dropzone
              label.form-label.form-label--strong Upload hero images
              .dropzone.dropzone-default.dropzone-modern.dz-clickable data-controller="dropzone"
                = f.file_field :images, multiple: true, as: :file, direct_upload: true, "data-dropzone-target": "input"
                .dropzone-msg.dz-message.needsclick
                  i.fa-solid.fa-cloud-arrow-up.dropzone-icon aria-hidden="true"
                  span.dropzone-title Drag files here or click to browse
                  span.dropzone-subtitle.text-muted.small First image becomes the new editorial hero frame
            .home-media-grid__info
              ul.list-unstyled.form-hint.mb-0
                li.d-flex.gap-2.mb-2
                  i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                  span.small Legacy design uses the whole set as a slider
                li.d-flex.gap-2.mb-2
                  i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                  span.small Editorial design uses only the first image in the ordered list
                li.d-flex.gap-2
                  i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                  span.small Reorder after upload by dragging images below

          - if home.images.present?
            .section-header.mt-4
              div
                h5.section-header__title Images in Home Page
                p.section-header__meta Select, reorder or remove uploaded hero media
            = render "admin/homes/images", home: home

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Legacy
            |  Old hero
          p.card-subtitle.text-muted.small Fields used by the current legacy homepage
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Title
                p.input-card__hint Headline for the old slider layout
                = f.text_field :title, class: "form-control input-card__control", placeholder: "Your headline"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Intro text
                p.input-card__hint Short teaser under the old hero title
                = f.text_area :body, class: "form-control input-card__control", rows: 4, placeholder: "Legacy intro"

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Legacy
            |  Old about block
          p.card-subtitle.text-muted.small Content used only by the previous homepage layout
        .card-body
          .input-card
            h5.input-card__title Block title
            p.input-card__hint Heading above the biography in the legacy layout
            = f.text_field :title_block1, class: "form-control input-card__control", placeholder: "About me"

          .input-card.mt-3 data-controller="rich-text"
            h5.input-card__title Bio text
            p.input-card__hint Rich text for the legacy about section
            .rich-text
              .rich-text__toolbar.btn-toolbar role="toolbar" aria-label="Bio text formatting controls"
                .btn-group.me-1 role="group" aria-label="Text emphasis"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="bold" title="Bold"
                    i.fa-solid.fa-bold aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="italic" title="Italic"
                    i.fa-solid.fa-italic aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="underline" title="Underline"
                    i.fa-solid.fa-underline aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="strikeThrough" title="Strikethrough"
                    i.fa-solid.fa-strikethrough aria-hidden="true"
                .btn-group.me-1 role="group" aria-label="Lists"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="insertUnorderedList" title="Bulleted list"
                    i.fa-solid.fa-list-ul aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="insertOrderedList" title="Numbered list"
                    i.fa-solid.fa-list-ol aria-hidden="true"
                .btn-group.me-1 role="group" aria-label="Headings"
                  select.form-select.form-select-sm aria-label="Heading level" data-action="change->rich-text#applyBlock"
                    option value="p" Paragraph
                    option value="h3" Heading 3
                    option value="h4" Heading 4
                .btn-group.me-1 role="group" aria-label="Extras"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#insertLink" title="Insert link"
                    i.fa-solid.fa-link aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="unlink" title="Remove link"
                    i.fa-solid.fa-link-slash aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="formatBlock" data-rich-text-value-param="blockquote" title="Block quote"
                    i.fa-solid.fa-quote-right aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="formatBlock" data-rich-text-value-param="pre" title="Code block"
                    i.fa-solid.fa-code aria-hidden="true"
                .btn-group role="group" aria-label="History"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="undo" title="Undo"
                    i.fa-solid.fa-rotate-left aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="redo" title="Redo"
                    i.fa-solid.fa-rotate-right aria-hidden="true"
                  button.btn.btn-sm.btn-outline-secondary type="button" data-action="rich-text#format" data-rich-text-command-param="removeFormat" title="Clear formatting"
                    i.fa-solid.fa-eraser aria-hidden="true"
              .rich-text__editor.form-control.input-card__control role="textbox" aria-label="Bio text editor" contenteditable="true" data-rich-text-target="editor" data-action="input->rich-text#onInput blur->rich-text#sync paste->rich-text#onPaste" data-placeholder="Share your story"
            = f.hidden_field :body_block1, data: { rich_text_target: "input" }

          label.form-label.form-label--strong.mt-4 Upload portrait / about photo
          p.form-hint This single image is reused by both the old about block and the new editorial section
          .dropzone.dropzone-default.dropzone-modern.dz-clickable data-controller="dropzone"
            = f.file_field :image, as: :file, direct_upload: true, "data-dropzone-target": "input"
            .dropzone-msg.dz-message.needsclick
              i.fa-solid.fa-cloud-arrow-up.dropzone-icon aria-hidden="true"
              span.dropzone-title Drag file here or click to browse
              span.dropzone-subtitle.text-muted.small Square or portrait crop works best

          - if home.image.attached?
            .section-header.mt-4
              div
                h5.section-header__title Current portrait
                p.section-header__meta Use the trash icon to remove the uploaded photo
            .about-photo
              .row.g-3.align-items-start
                .col-auto
                  .item data-src="#{url_for(home.image.variant(resize_to_limit: [2000, 1200]))}"
                    a href="#{url_for(home.image.variant(resize_to_limit: [1000, 670]))}"
                      = image_tag home.image.variant(resize_to_limit: [210, 210]), class: "img-fluid rounded-3 shadow-sm"
                  .card-img-overlay
                    = link_to delete_photo_attachment_admin_home_url(home), data: { turbo_method: :delete }, class: "img-btn-edit" do
                      i.fas.fa-trash

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Editorial
            |  Hero & strip
          p.card-subtitle.text-muted.small Core copy for the new homepage hero
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Eyebrow
                p.input-card__hint Small line above the hero heading
                = f.text_field :hero_eyebrow, class: "form-control input-card__control", placeholder: Home::EDITORIAL_DEFAULTS[:hero_eyebrow]
            .col-12.col-md-6
              .input-card
                h5.input-card__title Hero title
                p.input-card__hint Main heading on the editorial hero card
                = f.text_field :hero_title, class: "form-control input-card__control", placeholder: Home::EDITORIAL_DEFAULTS[:hero_title]
            .col-12
              .input-card
                h5.input-card__title Hero body
                p.input-card__hint Lead paragraph on the first screen
                = f.text_area :hero_body, class: "form-control input-card__control", rows: 4, placeholder: Home::EDITORIAL_DEFAULTS[:hero_body]
            .col-12.col-md-4
              .input-card
                h5.input-card__title Primary CTA
                p.input-card__hint Button pointing to the reports section
                = f.text_field :hero_primary_cta_label, class: "form-control input-card__control"
            .col-12.col-md-4
              .input-card
                h5.input-card__title Secondary CTA
                p.input-card__hint Contact button text
                = f.text_field :hero_secondary_cta_label, class: "form-control input-card__control"
            .col-12.col-md-4
              .input-card
                h5.input-card__title Scroll cue
                p.input-card__hint Small button under the hero card
                = f.text_field :scroll_cue_label, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Headline strip
                p.input-card__hint Running line under the hero section
                = f.text_field :headline_strip_text, class: "form-control input-card__control"

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Editorial
            |  Reports section
          p.card-subtitle.text-muted.small Copy above and around the gallery composition block
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Eyebrow
                = f.text_field :reports_eyebrow, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Title
                = f.text_field :reports_title, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Intro paragraph
                = f.text_area :reports_body, class: "form-control input-card__control", rows: 4
            .col-12.col-lg-6
              .input-card
                h5.input-card__title Intro block
                p.input-card__hint Left descriptive block above the gallery cards
                = f.text_field :reports_intro_title, class: "form-control input-card__control mb-2", placeholder: "Серии под публикацию"
                = f.text_area :reports_intro_text, class: "form-control input-card__control", rows: 4
            .col-12.col-lg-6
              .row.g-4
                .col-12
                  .input-card
                    h5.input-card__title Focus block
                    = f.text_field :reports_focus_title, class: "form-control input-card__control mb-2"
                    = f.text_area :reports_focus_text, class: "form-control input-card__control", rows: 3
                .col-12
                  .input-card
                    h5.input-card__title Delivery block
                    = f.text_field :reports_delivery_title, class: "form-control input-card__control mb-2"
                    = f.text_area :reports_delivery_text, class: "form-control input-card__control", rows: 3
                .col-12
                  .input-card
                    h5.input-card__title Result block
                    = f.text_field :reports_result_title, class: "form-control input-card__control mb-2"
                    = f.text_area :reports_result_text, class: "form-control input-card__control", rows: 3

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Editorial
            |  About section
          p.card-subtitle.text-muted.small Full copy, aside facts and metrics for the new “About” block
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Eyebrow
                = f.text_field :about_eyebrow, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Photo caption
                = f.text_field :about_photo_caption, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Title
                = f.text_field :about_title, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Main paragraph
                = f.text_area :about_body, class: "form-control input-card__control", rows: 4
            .col-12
              .input-card
                h5.input-card__title Secondary paragraph
                = f.text_area :about_body_secondary, class: "form-control input-card__control", rows: 4
            .col-12
              .input-card
                h5.input-card__title Quote
                = f.text_area :about_quote, class: "form-control input-card__control", rows: 3
            .col-12.col-lg-4
              .input-card
                h5.input-card__title Aside index
                = f.text_field :about_aside_index, class: "form-control input-card__control"
            .col-12.col-lg-4
              .input-card
                h5.input-card__title Aside title
                = f.text_field :about_aside_title, class: "form-control input-card__control"
            .col-12.col-lg-4
              .input-card
                h5.input-card__title Aside text
                = f.text_area :about_aside_text, class: "form-control input-card__control", rows: 3
            - 3.times do |index|
              - number = index + 1
              .col-12.col-md-6
                .input-card
                  h5.input-card__title = "Fact #{number}"
                  = f.text_field :"about_fact_#{number}_label", class: "form-control input-card__control mb-2", placeholder: "Label"
                  = f.text_field :"about_fact_#{number}_value", class: "form-control input-card__control", placeholder: "Value"
            - 4.times do |index|
              - number = index + 1
              .col-12.col-md-6
                .input-card
                  h5.input-card__title = "Metric #{number}"
                  = f.text_field :"about_metric_#{number}_value", class: "form-control input-card__control mb-2", placeholder: "Value"
                  = f.text_area :"about_metric_#{number}_label", class: "form-control input-card__control", rows: 3, placeholder: "Description"

      .card.section-card
        .card-header
          h4.card-title
            span.card-chip Editorial
            |  Contact section
          p.card-subtitle.text-muted.small Text block and card labels for the right-side contact panel
        .card-body
          .row.g-4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Eyebrow
                = f.text_field :contacts_eyebrow, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Card eyebrow
                = f.text_field :contacts_card_eyebrow, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Title
                = f.text_area :contacts_title, class: "form-control input-card__control", rows: 3
            .col-12
              .input-card
                h5.input-card__title Body
                = f.text_area :contacts_body, class: "form-control input-card__control", rows: 4
            .col-12.col-md-6
              .input-card
                h5.input-card__title Location label
                = f.text_field :contacts_location_label, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Location value
                = f.text_field :contacts_location_value, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Phone label
                = f.text_field :contacts_phone_label, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Phone value
                = f.text_field :contacts_phone_value, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Email label
                = f.text_field :contacts_email_label, class: "form-control input-card__control"
            .col-12.col-md-6
              .input-card
                h5.input-card__title Email value
                = f.email_field :contacts_email_value, class: "form-control input-card__control"
            .col-12
              .input-card
                h5.input-card__title Social label
                p.input-card__hint Icons and URLs are managed globally in Site Settings
                = f.text_field :contacts_social_label, class: "form-control input-card__control"

    .home-settings__column.home-settings__column--sidebar
      .home-card-stack
        .card.section-card
          .card-header
            h4.card-title
              span.card-chip Editorial
              |  Homepage gallery slots
            p.card-subtitle.text-muted.small Pick which galleries feed each card in the new layout
          .card-body
            - Home::EDITORIAL_GALLERY_LABELS.each_with_index do |(field, label), index|
              .input-card class=("mt-3" if index.positive?)
                h5.input-card__title = label
                p.input-card__hint Gallery media, tags and captions come from that gallery's own settings
                = f.select field, options_for_select(editorial_gallery_options(galleries), home.public_send(field)), {}, class: "form-select input-card__control"

        .card.section-card
          .card-header
            h4.card-title
              span.card-chip Notes
              |  Content flow
            p.card-subtitle.text-muted.small Quick reference for how data maps to the new home
          .card-body
            ul.list-unstyled.form-hint.mb-0
              li.d-flex.gap-2.mb-2
                i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                span.small Each gallery card on the editorial homepage reads its title, captions, overlay and tags from the selected gallery
              li.d-flex.gap-2.mb-2
                i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                span.small The first hero image is reused as the top full-screen background
              li.d-flex.gap-2
                i.fa-solid.fa-circle-check.text-admin-primary.mt-1 aria-hidden="true"
                span.small Social icons in the contact card come from Site Settings, not from the Home record

  .form-actions.mt-4
    = f.submit home.persisted? ? "Save changes" : "Create home page", class: "btn btn-primary"
    = link_to "Cancel", admin_homes_path, class: "btn btn-outline-secondary"
