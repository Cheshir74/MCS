doctype html
html
  head
    title =@site_setting.name_site
    meta name="yandex-verification" content=@site_setting.yn_verification_pri
    meta name="yandex-verification" content=@site_setting.yn_verification_sec
    meta name="robots" content="noindex, nofollow"
    = csrf_meta_tags
    = csp_meta_tag
    = site_favicon_tag

    = javascript_include_tag "admin", "data-turbo-track": "reload", type: "module"
    = stylesheet_link_tag 'admin', media: 'all'

  body class="admin-layout admin-layout--future" data-admin-sidebar-storage-key="admin:sidebar:state"
    = javascript_tag nonce: true do
      | (() => {
      |   try {
      |     const storageKey = "admin:sidebar:state";
      |     if (window.matchMedia("(min-width: 1181px)").matches && window.localStorage.getItem(storageKey) === "collapsed") {
      |       document.body.classList.add("sidebar-icon-only");
      |     }
      |   } catch (error) {
      |   }
      | })();
    - unless flash.empty?
      = render 'layouts/notice'
    div.admin-shell
      = render 'layouts/admin/sidebar'
      div.admin-shell__body
        = render 'layouts/admin/header'
        div.admin-shell__main
          main.admin-shell__content
            = yield
          = render 'layouts/admin/footer'
