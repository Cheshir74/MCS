nav class="navbar admin-topbar fixed-top d-flex align-items-center"
  div class="admin-topbar__left d-flex align-items-center"
    button class="admin-topbar__toggle btn btn-icon" type="button" data-toggle="minimize"
      i class="fa-solid fa-bars" aria-hidden="true"
    = link_to admin_path, class: "admin-topbar__brand"
      - if @site_setting&.logo&.attached?
        = image_tag @site_setting.logo.variant(resize_to_limit: [28, 28]), class: "admin-topbar__brand-logo", alt: @site_setting&.name_site || "Admin"
      - else
        = image_tag "test_logo_1.png", class: "admin-topbar__brand-logo admin-topbar__brand-logo--fallback", alt: @site_setting&.name_site || "Admin"
      span class="admin-topbar__brand-name" = @site_setting&.name_site || "Admin"

  div class="admin-topbar__right ms-auto d-flex align-items-center gap-3"
    - env_label = Rails.env.production? ? ['Production', 'bg-success-subtle text-success'] : [Rails.env, 'bg-warning-subtle text-warning']
    span class="badge #{env_label.last} fw-semibold small text-uppercase"= env_label.first.to_s.upcase

    details class="admin-topbar__profile"
      summary class="admin-topbar__profile-summary"
        div class="avatar-circle"
          span= (current_user&.email.to_s.first || "U").upcase
        div class="admin-topbar__profile-text"
          span class="fw-semibold text-dark"= current_user&.email || "Account"
          - if current_user&.superadmin_role?
            span class="text-muted small text-uppercase" Administrator
          - elsif current_user&.supervisor_role?
            span class="text-muted small text-uppercase" Editor
          - else
            span class="text-muted small text-uppercase" Viewer
        i class="fa-solid fa-chevron-down admin-topbar__profile-icon" aria-hidden="true"
      ul class="admin-topbar__profile-menu"
        li
          = link_to 'Account settings', edit_admin_user_path(current_user), class: 'admin-topbar__profile-link'
        li
          = link_to 'Brand & contact', admin_path, class: 'admin-topbar__profile-link'
        li class="admin-topbar__profile-divider"
        li
          = link_to 'Log out', destroy_user_session_path, class: 'admin-topbar__profile-link admin-topbar__profile-link--danger', data: { turbo_method: :delete }
