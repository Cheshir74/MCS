{
  "name": "MCS",
  "private": true,
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^7.2.302",
    "@rails/activestorage": "^7.2.302",
    "@rails/ujs": "7.1.3-4",
    "add": "^2.0.9",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "channels": "^0.0.4",
    "core-js": "^3.50.0",
    "dropzone": "^6.0.0-beta.2",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.1.0",
    "fslightbox-react": "^2.1.0",
    "jquery": "^4.0.0",
    "lg-fullscreen": "^1.2.1",
    "lg-hash": "^1.0.4",
    "lg-pager": "^1.0.2",
    "lightgallery": "^2.9.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react_ujs": "^3.3.1",
    "sass": "^1.102.0",
    "stimulus": "^3.2.2",
    "swiper": "^14.1.0",
    "toastr": "^2.1.4",
    "turbolinks": "^5.2.0",
    "typeface-lora": "^1.1.13",
    "yarn": "^1.22.22"
  },
  "version": "0.1.0",
  "scripts": {
    "build": "yarn build:css && esbuild app/javascript/*.* --bundle --loader:.ttf=file --loader:.js=jsx --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css:compile": "sass --style compressed --quiet-deps --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=if-function ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css_admin:compile": "sass --style compressed --quiet-deps --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=if-function ./app/assets/stylesheets/admin.scss:./app/assets/builds/admin.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css_admin:prefix": "postcss ./app/assets/builds/admin.css --use=autoprefixer --output=./app/assets/builds/admin.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix && yarn build:css_admin:compile && yarn build:css_admin:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "packageManager": "yarn@4.18.0",
  "browserslist": [
    "defaults"
  ]
}
