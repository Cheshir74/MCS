#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "securerandom"

destination = ARGV.fetch(0, "staging")
key = ARGV.fetch(1)
root = File.expand_path("..", __dir__)
secrets_path = File.join(root, ".kamal", "secrets.#{destination}.local")

def read_pairs(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, pairs|
    next if line.empty? || line.start_with?("#")

    name, value = line.split("=", 2)
    pairs[name] = value if name && value
  end
end

def write_pairs(path, pairs)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, pairs.sort.map { |name, value| "#{name}=#{value}" }.join("\n") + "\n", mode: "w", perm: 0o600)
end

def master_key(root)
  path = File.join(root, "config", "master.key")
  abort "Missing config/master.key. Copy the production master key here before deploying." unless File.exist?(path)

  File.read(path).strip
end

pairs = read_pairs(secrets_path)

unless pairs.key?(key)
  pairs[key] =
    case key
    when "DATABASE_PASSWORD"
      SecureRandom.hex(32)
    when "POSTGRES_PASSWORD"
      pairs["DATABASE_PASSWORD"] || SecureRandom.hex(32)
    when "ENCRYPTION_KEY"
      SecureRandom.hex(32)
    when "SECRET_KEY_BASE"
      SecureRandom.hex(64)
    when "RAILS_MASTER_KEY"
      master_key(root)
    else
      abort "Unknown Kamal secret: #{key}"
    end

  pairs["POSTGRES_PASSWORD"] = pairs["DATABASE_PASSWORD"] if key == "DATABASE_PASSWORD"
  write_pairs(secrets_path, pairs)
end

puts pairs.fetch(key)
