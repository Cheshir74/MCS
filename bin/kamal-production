#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

LOCAL_CONFIG=".kamal/deploy.production.local"

PROVIDED_PRODUCTION_HOST="${PRODUCTION_HOST:-}"
PROVIDED_PRODUCTION_APP_HOST="${PRODUCTION_APP_HOST:-}"
PROVIDED_PRODUCTION_USER="${PRODUCTION_USER:-}"
PROVIDED_PRODUCTION_SSH_PORT="${PRODUCTION_SSH_PORT:-}"
PROVIDED_PRODUCTION_SSL="${PRODUCTION_SSL:-}"
PROVIDED_PRODUCTION_FORCE_SSL="${PRODUCTION_FORCE_SSL:-}"
PROVIDED_PRODUCTION_POSTGRES_DATA_DIR="${PRODUCTION_POSTGRES_DATA_DIR:-}"
PROVIDED_PRODUCTION_STORAGE_DIR="${PRODUCTION_STORAGE_DIR:-}"
PROVIDED_PRODUCTION_BACKUP_DIR="${PRODUCTION_BACKUP_DIR:-}"

if [[ -f "$LOCAL_CONFIG" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$LOCAL_CONFIG"
  set +a
fi

PRODUCTION_HOST="${PROVIDED_PRODUCTION_HOST:-${PRODUCTION_HOST:-}}"
PRODUCTION_APP_HOST="${PROVIDED_PRODUCTION_APP_HOST:-${PRODUCTION_APP_HOST:-}}"
PRODUCTION_USER="${PROVIDED_PRODUCTION_USER:-${PRODUCTION_USER:-}}"
PRODUCTION_SSH_PORT="${PROVIDED_PRODUCTION_SSH_PORT:-${PRODUCTION_SSH_PORT:-}}"
PRODUCTION_SSL="${PROVIDED_PRODUCTION_SSL:-${PRODUCTION_SSL:-}}"
PRODUCTION_FORCE_SSL="${PROVIDED_PRODUCTION_FORCE_SSL:-${PRODUCTION_FORCE_SSL:-}}"
PRODUCTION_POSTGRES_DATA_DIR="${PROVIDED_PRODUCTION_POSTGRES_DATA_DIR:-${PRODUCTION_POSTGRES_DATA_DIR:-}}"
PRODUCTION_STORAGE_DIR="${PROVIDED_PRODUCTION_STORAGE_DIR:-${PRODUCTION_STORAGE_DIR:-}}"
PRODUCTION_BACKUP_DIR="${PROVIDED_PRODUCTION_BACKUP_DIR:-${PRODUCTION_BACKUP_DIR:-}}"

export PRODUCTION_HOST
export PRODUCTION_APP_HOST
export PRODUCTION_USER
export PRODUCTION_SSH_PORT
export PRODUCTION_SSL
export PRODUCTION_FORCE_SSL
export PRODUCTION_POSTGRES_DATA_DIR
export PRODUCTION_STORAGE_DIR
export PRODUCTION_BACKUP_DIR

if [[ -z "${PRODUCTION_HOST:-}" ]]; then
  printf "Missing PRODUCTION_HOST. Run bin/kamal-first-deploy-production first or create %s.\n" "$LOCAL_CONFIG" >&2
  exit 1
fi

exec env KAMAL_PUBLIC_REGISTRY=1 bin/kamal-public "$@" -d production
