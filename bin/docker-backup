#!/bin/bash
set -euo pipefail

COMPOSE_FILE="${COMPOSE_FILE:-compose.production.yml}"
COMPOSE_ENV_FILE="${COMPOSE_ENV_FILE:-.env.production}"
STAMP="$(date +%F-%H%M%S)"

mkdir -p backups

docker compose --env-file "$COMPOSE_ENV_FILE" -f "$COMPOSE_FILE" exec -T postgres sh -c \
  'pg_dump -Fc -U "$POSTGRES_USER" "$POSTGRES_DB"' \
  > "backups/mcs-${STAMP}.dump"

rsync -a data/storage/ "backups/storage-${STAMP}/"

echo "Created backups/mcs-${STAMP}.dump"
echo "Created backups/storage-${STAMP}/"
