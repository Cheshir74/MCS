#!/bin/bash
set -euo pipefail

mkdir -p data/postgres data/storage backups secrets

if [ ! -f .env.production ]; then
  cp .env.production.example .env.production
  echo "Created .env.production from .env.production.example"
else
  echo ".env.production already exists"
fi

if [ ! -f secrets/credentials.yml.enc ] && [ -f config/credentials.yml.enc ]; then
  cp config/credentials.yml.enc secrets/credentials.yml.enc
  echo "Copied config/credentials.yml.enc to secrets/credentials.yml.enc"
elif [ -f secrets/credentials.yml.enc ]; then
  echo "secrets/credentials.yml.enc already exists"
else
  echo "WARNING: secrets/credentials.yml.enc is missing"
  echo "Put production credentials at secrets/credentials.yml.enc before deploy."
fi

echo
echo "Next steps:"
echo "1. Edit .env.production"
echo "2. Run: bin/docker-deploy"
