#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

HOST="${STAGING_HOST:-89.22.234.238}"
USER="${STAGING_USER:-depus}"
SSH_TARGET="${USER}@${HOST}"
POSTGRES_DATA_DIR="${STAGING_POSTGRES_DATA_DIR:-/home/depus/mcs/postgres/data}"
BACKUP_DIR="${STAGING_BACKUP_DIR:-/home/depus/mcs/backups}"
KAMAL_IMAGE_VERSION="${KAMAL_VERSION:-latest}"

info() {
  printf "\n==> %s\n" "$1"
}

run() {
  printf "+ %s\n" "$*"
  "$@"
}

ensure_ssh_key_access() {
  local key_path="${KAMAL_SSH_KEY:-$HOME/.ssh/id_ed25519}"

  info "Ensure key-based SSH access"

  if ssh -o BatchMode=yes "$SSH_TARGET" "true" 2>/dev/null; then
    printf "Key-based SSH is already working for %s.\n" "$SSH_TARGET"
    return
  fi

  if [[ ! -f "${key_path}.pub" ]]; then
    mkdir -p "$(dirname "$key_path")"
    run ssh-keygen -t ed25519 -f "$key_path" -N "" -C "kamal-deploy-$(whoami)@$(hostname)"
  fi

  printf "Installing SSH public key on %s. Enter the SSH password once if prompted.\n" "$SSH_TARGET"
  if command -v ssh-copy-id >/dev/null 2>&1; then
    run ssh-copy-id -i "${key_path}.pub" "$SSH_TARGET"
  else
    local public_key
    public_key="$(tr -d '\n' < "${key_path}.pub")"
    printf "%s\n" "$public_key" | ssh "$SSH_TARGET" 'read -r key; mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && grep -qxF "$key" ~/.ssh/authorized_keys || printf "%s\n" "$key" >> ~/.ssh/authorized_keys'
  fi

  if ! ssh -o BatchMode=yes "$SSH_TARGET" "true" 2>/dev/null; then
    printf "Key-based SSH still does not work for %s. Check ~/.ssh/authorized_keys on the server.\n" "$SSH_TARGET" >&2
    exit 1
  fi
}

check_port_80() {
  info "Check port 80 availability"

  if ! ssh "$SSH_TARGET" "ss -ltn 'sport = :80' | grep -q LISTEN"; then
    return
  fi

  if ssh "$SSH_TARGET" "docker ps --filter 'name=^kamal-proxy$' --filter status=running --quiet | grep -q ."; then
    printf "Port 80 is already owned by running kamal-proxy; continuing.\n"
    return
  fi

  printf "Port 80 is already in use on %s.\n" "$SSH_TARGET" >&2
  printf "Kamal proxy needs port 80. Stop the existing web server first, then remove the failed created proxy container if present:\n" >&2
  printf "  ssh %s \"sudo systemctl disable --now nginx && docker rm kamal-proxy 2>/dev/null || true\"\n" "$SSH_TARGET" >&2
  exit 1
}

if [[ ! -f config/master.key ]]; then
  printf "Missing config/master.key. Copy the production master key here before first deploy.\n" >&2
  exit 1
fi

ensure_ssh_key_access

info "Generate missing local Kamal secrets"
run bin/kamal-secret staging RAILS_MASTER_KEY >/dev/null
run bin/kamal-secret staging DATABASE_PASSWORD >/dev/null
run bin/kamal-secret staging POSTGRES_PASSWORD >/dev/null
run bin/kamal-secret staging ENCRYPTION_KEY >/dev/null
run bin/kamal-secret staging SECRET_KEY_BASE >/dev/null
chmod 600 .kamal/secrets.staging.local

if ! git diff --quiet || ! git diff --cached --quiet; then
  info "Working tree has uncommitted changes"
  printf "This first deploy will pull ghcr.io/cheshir74/mcs:%s, so uncommitted changes will not be deployed.\n" "$KAMAL_IMAGE_VERSION"
fi

info "Check local dependencies"
run bundle check
run yarn install --immutable

info "Prepare server directories over SSH"
run ssh "$SSH_TARGET" "mkdir -p '$POSTGRES_DATA_DIR' '$BACKUP_DIR'"

info "Check Docker access over SSH"
if ! ssh "$SSH_TARGET" "docker ps >/dev/null 2>&1"; then
  printf "Docker is not ready for %s. Kamal setup will try to bootstrap Docker and may ask for sudo.\n" "$SSH_TARGET"
fi

check_port_80

info "Validate Kamal config"
run env KAMAL_PUBLIC_REGISTRY=1 bin/kamal-public config -d staging --version "$KAMAL_IMAGE_VERSION"

info "Run first Kamal setup"
run env KAMAL_PUBLIC_REGISTRY=1 bin/kamal-public setup -d staging --skip-push --version "$KAMAL_IMAGE_VERSION"

info "Prepare production database"
run env KAMAL_PUBLIC_REGISTRY=1 bin/kamal-public app exec --primary -d staging --version "$KAMAL_IMAGE_VERSION" "bundle exec rails db:prepare"

info "Health check"
run curl --fail --show-error --silent "http://${HOST}/up"
printf "\nFirst staging deploy finished.\n"
