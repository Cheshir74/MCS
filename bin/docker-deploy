#!/bin/bash
set -euo pipefail

COMPOSE_FILE="${COMPOSE_FILE:-compose.production.yml}"
COMPOSE_ENV_FILE="${COMPOSE_ENV_FILE:-.env.production}"

if [ ! -f "$COMPOSE_ENV_FILE" ]; then
  echo "Missing .env.production. Run bin/docker-setup first."
  exit 1
fi

set -a
source "$COMPOSE_ENV_FILE"
set +a

if [ ! -f secrets/credentials.yml.enc ]; then
  echo "Missing secrets/credentials.yml.enc. Run bin/docker-setup or copy it manually."
  exit 1
fi

COMPOSE=(docker compose --env-file "$COMPOSE_ENV_FILE" -f "$COMPOSE_FILE")

if [ "${DEPLOY_FROM_REGISTRY:-false}" = "true" ]; then
  "${COMPOSE[@]}" pull web
else
  "${COMPOSE[@]}" build
fi

"${COMPOSE[@]}" up -d postgres
"${COMPOSE[@]}" run --rm web bundle exec rails db:migrate
"${COMPOSE[@]}" up -d
"${COMPOSE[@]}" ps
