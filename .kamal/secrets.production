# This file is safe to commit: it references generated local secrets and
# does not contain raw credentials.

RAILS_MASTER_KEY=$(bin/kamal-secret production RAILS_MASTER_KEY)
DATABASE_PASSWORD=$(bin/kamal-secret production DATABASE_PASSWORD)
POSTGRES_PASSWORD=$(bin/kamal-secret production POSTGRES_PASSWORD)
ENCRYPTION_KEY=$(bin/kamal-secret production ENCRYPTION_KEY)
SECRET_KEY_BASE=$(bin/kamal-secret production SECRET_KEY_BASE)
